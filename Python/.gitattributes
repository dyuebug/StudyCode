# 统一换行符，避免 Windows 检出的 CRLF 破坏 Linux 脚本与容器构建
* text=auto

*.sh            text eol=lf
*.py            text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
